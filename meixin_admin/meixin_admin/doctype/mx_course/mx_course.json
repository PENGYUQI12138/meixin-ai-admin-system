{
 "doctype": "DocType",
 "name": "MX Course",
 "module": "Meixin Admin",
 "engine": "InnoDB",
 "custom": 0,
 "field_order": [
  "course_name",
  "subject",
  "default_duration_minutes",
  "enabled",
  "demo_batch"
 ],
 "fields": [
  {
   "fieldname": "course_name",
   "fieldtype": "Data",
   "label": "课程名称",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "subject",
   "fieldtype": "Select",
   "label": "学科",
   "options": "\n语文\n数学\n英语\n物理\n化学\n生物\n政治\n历史\n地理\n科学\n信息技术\n综合\n其他",
   "in_list_view": 1
  },
  {
   "fieldname": "default_duration_minutes",
   "fieldtype": "Int",
   "label": "默认时长（分钟）",
   "reqd": 1,
   "in_list_view": 1,
   "non_negative": 1,
   "description": "必须大于 0；排课时可按实际情况调整起止时间。"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "启用",
   "default": "1",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "demo_batch",
   "fieldtype": "Data",
   "label": "演示批次",
   "read_only": 1,
   "no_copy": 1,
   "description": "仅演示初始化命令填写；真实档案请留空。"
  }
 ],
 "permissions": [
  {
   "role": "Meixin Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "select": 1,
   "delete": 1,
   "report": 1,
   "export": 0,
   "share": 0,
   "print": 0,
   "email": 0
  },
  {
   "role": "Meixin Scheduler",
   "read": 1,
   "write": 1,
   "create": 1,
   "select": 1,
   "report": 1,
   "delete": 0,
   "export": 0,
   "share": 0,
   "print": 0,
   "email": 0
  }
 ],
 "actions": [],
 "links": [],
 "states": [],
 "track_changes": 1,
 "allow_rename": 0,
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "MX-CRS-.#####",
 "naming_rule": "Expression (old style)",
 "title_field": "course_name",
 "search_fields": "course_name",
 "show_title_field_in_link": 1
}
