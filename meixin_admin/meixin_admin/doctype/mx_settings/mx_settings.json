{
 "doctype": "DocType",
 "name": "MX Settings",
 "module": "Meixin Admin",
 "engine": "InnoDB",
 "custom": 0,
 "field_order": [
  "institution_name",
  "site_time_zone",
  "consumption_rules_section",
  "consumption_rules_notice",
  "present_rule",
  "leave_rule",
  "absent_rule",
  "other_rule",
  "session_cancel_rule"
 ],
 "fields": [
  {
   "fieldname": "institution_name",
   "fieldtype": "Data",
   "label": "机构名称",
   "default": "美心",
   "reqd": 1
  },
  {
   "fieldname": "site_time_zone",
   "fieldtype": "HTML",
   "label": "实际站点时区"
  },
  {
   "fieldname": "consumption_rules_section",
   "fieldtype": "Section Break",
   "label": "课消规则"
  },
  {
   "fieldname": "consumption_rules_notice",
   "fieldtype": "HTML",
   "label": "规则说明",
   "options": "<div class=\"alert alert-warning\">每项规则必须由美心管理员明确选择。未配置时，涉及该状态的执行提交或课程取消会被拒绝。</div>"
  },
  {
   "fieldname": "present_rule",
   "fieldtype": "Select",
   "label": "到课",
   "options": "未配置\n课消\n不课消",
   "default": "未配置",
   "reqd": 1
  },
  {
   "fieldname": "leave_rule",
   "fieldtype": "Select",
   "label": "请假",
   "options": "未配置\n课消\n不课消",
   "default": "未配置",
   "reqd": 1
  },
  {
   "fieldname": "absent_rule",
   "fieldtype": "Select",
   "label": "缺勤",
   "options": "未配置\n课消\n不课消",
   "default": "未配置",
   "reqd": 1
  },
  {
   "fieldname": "other_rule",
   "fieldtype": "Select",
   "label": "其他",
   "options": "未配置\n课消\n不课消",
   "default": "未配置",
   "reqd": 1
  },
  {
   "fieldname": "session_cancel_rule",
   "fieldtype": "Select",
   "label": "课程取消",
   "options": "未配置\n课消\n不课消",
   "default": "未配置",
   "reqd": 1
  }
 ],
 "permissions": [
  {
   "role": "Meixin Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "select": 1,
   "delete": 0,
   "report": 0,
   "export": 0,
   "share": 0,
   "print": 0,
   "email": 0
  }
 ],
 "actions": [],
 "links": [],
 "states": [],
 "track_changes": 1,
 "allow_rename": 0,
 "sort_field": "modified",
 "sort_order": "DESC",
 "issingle": 1
}
