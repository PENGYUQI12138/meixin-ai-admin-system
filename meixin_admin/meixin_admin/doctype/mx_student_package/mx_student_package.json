  {
   "role": "Meixin Scheduler",
   "read": 1,
   "write": 1,
   "create": 1,
   "select": 1,
   "delete": 0,
   "report": 1,
   "export": 0,
   "share": 0,
   "print": 0,
   "email": 0,
   "submit": 1,
   "cancel": 0,
   "amend": 0
  }
 ],
