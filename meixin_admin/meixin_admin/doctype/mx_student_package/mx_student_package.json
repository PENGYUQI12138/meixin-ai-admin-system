  {
   "fieldname": "deal_amount",
   "fieldtype": "Currency",
   "precision": "2",
   "label": "成交金额快照",
   "options": "currency",
   "reqd": 1,
   "read_only": 1,
   "non_negative": 1
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "币种快照",
   "options": "Currency",
   "default": "CNY",
   "reqd": 1,
   "read_only": 1
  },
  {
   "fieldname": "effective_from",
   "fieldtype": "Date",
