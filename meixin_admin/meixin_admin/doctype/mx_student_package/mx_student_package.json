  {
   "fieldname": "request_id",
   "fieldtype": "Data",
   "label": "系统请求标识",
   "reqd": 1,
   "read_only": 1,
   "hidden": 1,
   "unique": 1,
   "no_copy": 1
  },
  {
   "fieldname": "amended_from",
   "fieldtype": "Link",
   "label": "修订来源",
   "options": "MX Student Package",
   "read_only": 1,
   "no_copy": 1,
   "print_hide": 1
  },
  {
   "fieldname": "demo_batch",
   "fieldtype": "Data",
   "label": "测试批次",
   "read_only": 1,
   "no_copy": 1,
