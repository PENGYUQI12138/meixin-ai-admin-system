   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "expires_on",
   "fieldtype": "Date",
   "label": "失效日期",
   "in_list_view": 1
  },
  {
   "fieldname": "activated_at",
   "fieldtype": "Datetime",
   "label": "首次激活时间",
   "read_only": 1,
   "no_copy": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "source_reference",
   "fieldtype": "Small Text",
   "label": "报名/购买来源"
