{
 "doctype": "DocType",
 "name": "MX Package Plan",
 "module": "Meixin Admin",
 "engine": "InnoDB",
 "custom": 0,
 "field_order": [
  "plan_name",
  "course",
  "standard_credits",
  "standard_price",
  "currency",
  "enabled",
  "description",
  "demo_batch"
 ],
 "fields": [
  {
   "fieldname": "plan_name",
   "fieldtype": "Data",
   "label": "课包名称",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "course",
   "fieldtype": "Link",
   "label": "适用课程",
   "options": "MX Course",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "description": "M3 仅支持精确课程匹配。"
  },
  {
   "fieldname": "standard_credits",
   "fieldtype": "Int",
   "label": "标准课时数",
   "reqd": 1,
   "non_negative": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "standard_price",
   "fieldtype": "Currency",
   "precision": "2",
   "label": "标准价格",
   "options": "currency",
   "reqd": 1,
   "non_negative": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "currency",
   "fieldtype": "Link",
   "label": "币种",
   "options": "Currency",
   "default": "CNY",
   "reqd": 1,
   "read_only": 1
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "启用",
   "default": "1",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "description",
   "fieldtype": "Small Text",
   "label": "说明"
  },
  {
   "fieldname": "demo_batch",
   "fieldtype": "Data",
   "label": "测试批次",
   "read_only": 1,
   "no_copy": 1,
   "description": "仅隔离测试填写；真实记录留空。"
  }
 ],
 "permissions": [
  {
   "role": "Meixin Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "select": 1,
   "delete": 1,
   "report": 1,
   "export": 0,
   "share": 0,
   "print": 0,
   "email": 0
  },
  {
   "role": "Meixin Scheduler",
   "read": 1,
   "write": 0,
   "create": 0,
   "select": 1,
   "delete": 0,
   "report": 1,
   "export": 0,
   "share": 0,
   "print": 0,
   "email": 0
  }
 ],
 "actions": [],
 "links": [],
 "states": [],
 "track_changes": 1,
 "allow_rename": 0,
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "MX-PPL-.#####",
 "naming_rule": "Expression (old style)",
 "title_field": "plan_name",
 "search_fields": "plan_name,course",
 "show_title_field_in_link": 1
}
