{
 "doctype": "DocType",
 "name": "MX Room",
 "module": "Meixin Admin",
 "engine": "InnoDB",
 "custom": 0,
 "field_order": [
  "room_name",
  "capacity",
  "enabled",
  "demo_batch"
 ],
 "fields": [
  {
   "fieldname": "room_name",
   "fieldtype": "Data",
   "label": "教室名称",
   "reqd": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "capacity",
   "fieldtype": "Int",
   "label": "容纳人数",
   "reqd": 1,
   "in_list_view": 1,
   "non_negative": 1,
   "description": "必须大于 0；不得缩小到使未来已确认排课超员。"
  },
  {
   "fieldname": "enabled",
   "fieldtype": "Check",
   "label": "启用",
   "default": "1",
   "in_list_view": 1,
   "in_standard_filter": 1
  },
  {
   "fieldname": "demo_batch",
   "fieldtype": "Data",
   "label": "演示批次",
   "read_only": 1,
   "no_copy": 1,
   "description": "仅演示初始化命令填写；真实档案请留空。"
  }
 ],
 "permissions": [
  {
   "role": "Meixin Manager",
   "read": 1,
   "write": 1,
   "create": 1,
   "select": 1,
   "delete": 1,
   "report": 1,
   "export": 0,
   "share": 0,
   "print": 0,
   "email": 0
  },
  {
   "role": "Meixin Scheduler",
   "read": 1,
   "write": 1,
   "create": 1,
   "select": 1,
   "report": 1,
   "delete": 0,
   "export": 0,
   "share": 0,
   "print": 0,
   "email": 0
  }
 ],
 "actions": [],
 "links": [],
 "states": [],
 "track_changes": 1,
 "allow_rename": 0,
 "sort_field": "modified",
 "sort_order": "DESC",
 "autoname": "MX-ROM-.#####",
 "naming_rule": "Expression (old style)",
 "title_field": "room_name",
 "search_fields": "room_name",
 "show_title_field_in_link": 1
}
